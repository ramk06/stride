{
  "compilerOptions": {
    "target": "ES2022", "module": "Node16", "moduleResolution": "Node16", "strict": true,
    "esModuleInterop": true, "experimentalDecorators": true, "emitDecoratorMetadata": true,
    "outDir": "dist", "skipLibCheck": true, "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}